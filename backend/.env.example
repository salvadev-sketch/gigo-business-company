# =========================
# SERVER
# =========================
PORT=5000

# =========================
# DATABASE
# =========================
MONGO_URI=

# =========================
# AUTH (JWT)
# =========================
# Long, random, unguessable strings — used to sign access/refresh tokens.
# Generate e.g. with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# =========================
# CORS
# =========================
# Your deployed frontend URL (Vercel), needed for the cross-site refresh cookie to work
FRONTEND_URL=

# =========================
# CLOUDINARY (product image uploads)
# =========================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
